{
  "name": "baanto",
  "version": "0.1.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "baanto",
      "version": "0.1.0",
      "workspaces": [
        "apps/*",
        "packages/*"
      ],
      "engines": {
        "node": ">=24.0.0"
      }
    },
    "apps/api": {
      "name": "@baanto/api",
      "version": "0.1.0",
      "dependencies": {
        "@baanto/shared": "*"
      }
    },
    "apps/web": {
      "name": "@baanto/web",
      "version": "0.1.0",
      "dependencies": {
        "@baanto/shared": "*"
      }
    },
    "node_modules/@baanto/api": {
      "resolved": "apps/api",
      "link": true
    },
    "node_modules/@baanto/shared": {
      "resolved": "packages/shared",
      "link": true
    },
    "node_modules/@baanto/web": {
      "resolved": "apps/web",
      "link": true
    },
    "packages/shared": {
      "name": "@baanto/shared",
      "version": "0.1.0"
    }
  }
}
